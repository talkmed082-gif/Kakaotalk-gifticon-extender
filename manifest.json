{
  "manifest_version": 3,
  "name": "카카오 기프티콘 유효기간 자동 연장",
  "version": "1.2.0",
  "description": "gift.kakao.com에서 유효기간이 임박(기본 30일 이내)한 기프티콘의 '유효기간 연장'을 자동으로 신청합니다. 로그인된 선물함 화면에서만 동작하며, 30일 이상 확인하지 않으면 알려줍니다.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://gift.kakao.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gift.kakao.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "카카오 기프티콘 유효기간 자동 연장",
    "default_icon": "icon128.png"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
